{
  "name": "syndrome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/export-data.mjs && node scripts/notices.mjs && node scripts/validate-data.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "playwright test",
    "test:data": "node --test scripts/data-validation.test.mjs",
    "test:webkit": "playwright test --config=playwright.webkit.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lenis": "1.3.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "webgl-fluid-enhanced": "0.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "lighthouse": "13.0.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
